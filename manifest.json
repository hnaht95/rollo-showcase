---
layout: null
---
{%- assign home = site.static_files | where_exp: "f", "f.path contains '/home/'" | sort: "path" -%}
{%- assign settings = site.static_files | where_exp: "f", "f.path contains '/settings/'" | sort: "path" -%}
{
  "revision": {{ site.github.build_revision | jsonify }},
  "home": [{% for f in home %}{{ f.path | remove_first: "/" | jsonify }}{% unless forloop.last %}, {% endunless %}{% endfor %}],
  "settings": [{% for f in settings %}{{ f.path | remove_first: "/" | jsonify }}{% unless forloop.last %}, {% endunless %}{% endfor %}],
  "info": {% if site.data.photos %}{{ site.data.photos | jsonify }}{% else %}{}{% endif %}
}
